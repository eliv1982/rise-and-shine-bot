# OpenAI is the only supported provider (text, image, TTS, STT). See docs/production_env.md.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

BOT_TOKEN=your_telegram_bot_token_here

# Database backend:
# - PostgreSQL is used when DATABASE_URL starts with postgres:// or postgresql://.
#   With Docker Compose (production and dev-with-compose), PostgreSQL is the
#   `postgres` service defined in this repo's docker-compose.yml, reached at
#   the Compose DNS hostname `postgres` (not localhost/127.0.0.1 — those
#   resolve to the bot's own container). See docs/production_env.md.
# - SQLite is the fallback for direct local Python development (bot.py run
#   outside Docker Compose) when DATABASE_URL is absent.
DATABASE_URL=
SQLITE_DB_PATH=

# --- PostgreSQL (required by docker-compose.yml's `postgres` service; the
# bot's DATABASE_URL above should be built from these same values) ---
POSTGRES_USER=rise_bot
POSTGRES_PASSWORD=change_me
POSTGRES_DB=rise_bot
# Example production DATABASE_URL matching the values above:
# DATABASE_URL=postgresql://rise_bot:change_me@postgres:5432/rise_bot

# Docker Compose: для образа с Docker Hub (и для docker compose push) укажи свой логин
# DOCKERHUB_IMAGE=your_dockerhub_login/rise-and-shine-bot:latest

# Legacy image env names kept as fallback defaults for OPENAI_IMAGE_MODEL/OPENAI_IMAGE_SIZE
# below if those are unset; prefer the OPENAI_ names.
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_SIZE=1024x1024
IMAGE_API_TIMEOUT_SECONDS=240
SHOW_IMAGE_DEBUG=false
SCENE_PLANNER_SHADOW_ENABLED=false
TEXT_PLANNER_SHADOW_ENABLED=false
SCENE_PLANNER_IMAGE_PROMPT_ENABLED=false
TEXT_PLANNER_CONTROLLED_ENABLED=false
TEXT_MEMORY_CONTEXT_ENABLED=false
TEXT_REVIEWER_SHADOW_ENABLED=false
ORCHESTRATOR_SHADOW_ENABLED=false

# Model profile for new environments. Do not copy this block over existing production.
# First migration deploy: explicitly retain OPENAI_TEXT_MODEL=gpt-4o-mini in the live .env.
# Production preflight requires a literal model pin; switch to Luna only after approval.
# Text model (gpt-4o-mini remains supported as an explicit rollback override)
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_TEXT_TIMEOUT_SECONDS=60
# Luna / Terra: none preserves temperature; other efforts omit temperature.
OPENAI_TEXT_REASONING_EFFORT=none
# Optional total completion budget, including reasoning; blank keeps per-task 512/200.
OPENAI_TEXT_MAX_COMPLETION_TOKENS=

# Image model/options
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_TIMEOUT_SECONDS=240

# TTS
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_TIMEOUT_SECONDS=240

# STT
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=
OPENAI_STT_TIMEOUT_SECONDS=120
ALLOW_CROSS_LANGUAGE_STT_FALLBACK=false

# Лимит интерактивных генераций (/new) на пользователя за сутки UTC; 0 = без лимита
DAILY_GENERATION_LIMIT=5
# Backward-compatible legacy name; DAILY_GENERATION_LIMIT has priority if both are set
GENERATION_DAILY_LIMIT=5
# Для ручного тестирования: true = не применять дневной лимит
DISABLE_DAILY_GENERATION_LIMIT=false

# Очистка outputs: удалять файлы старше N дней (скрипт cleanup_outputs.py)
OUTPUT_MAX_AGE_DAYS=7

# Обогащение промпта картинки через текстовую модель (аффирмации → англ. промпт)
LLM_IMAGE_PROMPT_ENABLED=true

# Опционально: путь к ffmpeg (для озвучки с паузами). На Linux обычно не нужен — установи ffmpeg (apt install ffmpeg).

# В Docker задаётся автоматически (не нужно в .env на сервере): BOT_DATA_DIR=/app/data
